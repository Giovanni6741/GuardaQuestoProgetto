@page
@model PariniFSL.Pages.Activities.ManageModel

@{
    ViewData["Title"] = "Gestisci attività";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Gestisci attività</h1>
            <h2 class="h4 text-muted">@Model.Activity.Title</h2>
        </div>

        <a asp-page="./Index" class="btn btn-secondary">
            Torna alle attività
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <!-- DATI ATTIVITÀ -->

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Dettagli attività</h5>
        </div>

        <div class="card-body">

            <p>
                <strong>Descrizione:</strong><br />
                @Model.Activity.Description
            </p>

            <div class="row">

                <div class="col-md-6">
                    <strong>Docente referente:</strong>
                    @Model.Activity.DocenteReferente?.Email
                </div>

                <div class="col-md-6">
                    <strong>Periodo:</strong>
                    @Model.Activity.Periodo
                </div>

                <div class="col-md-6 mt-2">
                    <strong>Soggetto ospitante:</strong>
                    @Model.Activity.SoggettoOspitante
                </div>

                <div class="col-md-6 mt-2">
                    <strong>Sede:</strong>
                    @Model.Activity.SedeAttivita
                </div>

                <div class="col-md-6 mt-2">
                    <strong>Ore:</strong>
                    @Model.Activity.OreComplessive
                </div>

                <div class="col-md-6 mt-2">
                    <strong>Tipologia:</strong>
                    @Model.Activity.Tipologia
                </div>

            </div>

        </div>
    </div>

    <!-- STUDENTI GIÀ ISCRITTI -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                Studenti iscritti
                <span class="badge bg-primary">
                    @Model.Enrollments.Count
                </span>
            </h5>
        </div>

        <div class="card-body">

            @if (Model.Enrollments.Count == 0)
            {
                <p class="text-muted mb-0">
                    Nessuno studente è ancora iscritto a questa attività.
                </p>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Studente</th>
                                <th>Email</th>
                                <th>Classe</th>
                                <th>Iscritto da</th>
                                <th>Data iscrizione</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var enrollment in Model.Enrollments)
                            {
                                <tr>

                                    <td>
                                        @enrollment.Student.UserName
                                    </td>

                                    <td>
                                        @enrollment.Student.Email
                                    </td>

                                    <td>
                                        @enrollment.Student.SchoolClass?.Grade
                                        @enrollment.Student.SchoolClass?.Section
                                    </td>

                                    <td>
                                        @enrollment.EnrolledBy.UserName
                                    </td>

                                    <td>
                                        @enrollment.EnrolledAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td class="text-end">
                                        <form method="post"
                                              asp-page-handler="Remove"
                                              asp-route-id="@Model.Activity.Id"
                                              asp-route-studentId="@enrollment.StudentId"
                                              onsubmit="return confirm('Sei sicuro di voler disiscrivere questo studente dall’attività?');">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Disiscrivi
                                            </button>

                                        </form>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

    <!-- AGGIUNTA STUDENTI -->

    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Aggiungi studenti</h5>
        </div>

        <div class="card-body">

            @if (Model.AvailableStudents.Count == 0)
            {
                <p class="text-muted mb-0">
                    Tutti gli studenti disponibili sono già iscritti
                    a questa attività.
                </p>
            }
            else
            {
                <form method="post">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th style="width: 50px;"></th>
                                    <th>Studente</th>
                                    <th>Email</th>
                                    <th>Classe</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var student in Model.AvailableStudents)
                                {
                                    <tr>

                                        <td>
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   name="SelectedStudentIds"
                                                   value="@student.Id"
                                                   id="student_@student.Id" />
                                        </td>

                                        <td>
                                            <label for="student_@student.Id"
                                                   style="cursor:pointer;">
                                                @student.UserName
                                            </label>
                                        </td>

                                        <td>
                                            @student.Email
                                        </td>

                                        <td>
                                            <span class="badge bg-secondary">
                                                @student.ClassName
                                            </span>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                    <span asp-validation-for="SelectedStudentIds"
                          class="text-danger">
                    </span>

                    <div class="mt-3">

                        <button type="submit"
                                class="btn btn-primary">
                            Aggiungi studenti selezionati
                        </button>

                    </div>

                </form>
            }

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}